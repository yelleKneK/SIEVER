.Rproj.user
.Rhistory
.RData
.Ruserdata
.DS_Store

# Root-level Markdown other than the public documents is not tracked.
/*.md
!/README.md
!/NEWS.md
!/LICENSE.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/cran-comments.md
dev/
inst/doc
# A vignette rendered in place (Knit in RStudio, or tools::buildVignettes(dir
# = ".")) leaves its HTML and purled R beside the source; they are build
# products, regenerated by devtools::build_vignettes() into doc/.
/vignettes/*.html
/vignettes/*.R
*.Rcheck/
*.tar.gz
*.tgz
doc/
Meta/
docs/

# shinytest2 and chromote per-run debris. Accepted snapshots under
# tests/testthat/_snaps are source and stay committed; only the pending
# artifacts a failing run leaves behind are ignored.
tests/testthat/_snaps/**/*.new.*
tests/testthat/_snaps/**/*.new
tests/testthat/*.new.png
chrome-debug.log
tests/testthat/_problems/
